      "version": 1,
      "codigo": "Q1",
      "nombre": "Ingreso neto por mes",
      "descripcion": "Calcula el ingreso neto acumulado agrupado por año y mes.",
      "plantilla_sql": "SELECT t.anio, t.mes, t.nombre_mes,\n               ROUND(SUM(f.ingreso_neto), 2) AS ingreso_neto\n        FROM FactVentas f\n        JOIN DimTiempo t ON t.sk_tiempo = f.sk_tiempo\n        WHERE t.fecha BETWEEN :desde AND :hasta\n        GROUP BY t.anio, t.mes, t.nombre_mes\n        ORDER BY t.anio, t.mes;",
      "parametros_esperados": [
        "desde",
        "hasta"
      ],
      "fuente_dato_oid": "FUEN-C892A27EA320",
      "regla_calculo": "Ingreso neto = SUM(ingreso_neto) = SUM(ingreso_bruto - descuento)",
      "reglas_validacion_oids": [
